{
  "name": "truframe",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome ci . && node scripts/check-deps.ts && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome check --write . && cargo fmt --all",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:deps": "node scripts/check-deps.ts",
    "check:licenses": "node scripts/check-licenses.ts && cargo deny check licenses bans sources",
    "deploy:staging": "node scripts/deploy.ts staging",
    "deploy:production": "node scripts/deploy.ts production",
    "db:generate": "pnpm --filter @truframe/db db:generate",
    "db:migrate": "pnpm --filter @truframe/web db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  }
}
