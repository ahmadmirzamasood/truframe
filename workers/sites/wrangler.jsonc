// Truframe sites: Cloudflare config for dev (top level, Miniflare), staging and production.
// Bindings are not inherited by environments in wrangler, so each env repeats them.
// Resource IDs are omitted: `wrangler dev` simulates everything locally, and the first deploy of
// each env provisions/links resources (see docs/runbooks/cloudflare-setup.md). Commit the IDs
// wrangler writes back. scripts/lib/wrangler-config.test.ts checks that envs stay consistent.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truframe-sites-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8791,
    "inspector_port": 9234
  },
  // TRUFRAME_APP_ORIGIN: the only origin allowed to frame /preview and post to it. Staging and
  // production set it when their app hostnames exist (docs/runbooks/cloudflare-setup.md).
  "vars": {
    "TRUFRAME_ENV": "local",
    "TRUFRAME_APP_ORIGIN": "http://localhost:3000"
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "truframe-dev-files"
    }
  ],
  "env": {
    "staging": {
      "name": "truframe-sites-staging",
      "vars": {
        "TRUFRAME_ENV": "staging"
      },
      "kv_namespaces": [
        {
          "binding": "CONFIG"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "truframe-staging-files"
        }
      ]
    },
    "production": {
      "name": "truframe-sites-production",
      "vars": {
        "TRUFRAME_ENV": "production"
      },
      "kv_namespaces": [
        {
          "binding": "CONFIG"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "truframe-production-files"
        }
      ]
    }
  }
}
