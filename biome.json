{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!fixtures/compiler",
      "!crates/compiler/templates",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**", "!packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "drizzle-orm": "Tables and Drizzle live in packages/db. Use the workspace-scoped repos from @truframe/db (docs/engineering/SECURITY.md, tenant isolation)."
                },
                "patterns": [
                  {
                    "group": [
                      "drizzle-orm/**",
                      "**/db/src/**",
                      "@truframe/db/src/**",
                      "@truframe/db/schema",
                      "@truframe/db/schema/**"
                    ],
                    "message": "Tables and Drizzle live in packages/db. Use the workspace-scoped repos from @truframe/db (docs/engineering/SECURITY.md, tenant isolation)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
