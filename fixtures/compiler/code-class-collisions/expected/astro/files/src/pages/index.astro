---
import Base from "../layouts/Base.astro";
---

<Base title="Home">
  <main class="body flex flex-col w-full h-fit">
    <div class="container-el flex">
      <p class="flex-el">Flex</p>
      <p class="grid-el">Grid</p>
      <p class="hidden-el">Hidden</p>
      <p class="text-center-el">Text center</p>
      <p class="card">Card 1</p>
      <p class="card-2">Card 2</p>
      <p class="card-3">Card 3</p>
      <p class="text">Unnamed text</p>
      <p class="text-el-2">Emoji name</p>
      <p class="layer-2024-plans">Starts with a digit</p>
      <p class="hero-section">Pascal case</p>
      <p class="p">Single letter</p>
      <p class="p-el-2">Single letter again</p>
      <p class="group-el">Variant name</p>
      <p class="mobile-el">Our breakpoint variant</p>
    </div>
  </main>
</Base>
