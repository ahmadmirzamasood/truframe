---
import Base from "../layouts/Base.astro";
---

<Base title="Home">
  <main class="body flex flex-col w-full h-fit">
    <section
      class="hero flex flex-col items-center gap-6 px-8 py-24 flex-none self-stretch h-fit mobile:gap-4 mobile:px-5 mobile:py-14"
    >
      <h1
        class="text text-[56px] font-bold text-center text-(color:--neutral-ink) mobile:text-4xl"
      >
        The simplest way to run your team
      </h1>
      <a
        href="/pricing"
        class="button flex px-6 py-3 bg-(--brand-accent) rounded-lg"
      >
        <span class="label font-semibold text-[#ffffff]">
          Start a free trial
        </span>
      </a>
    </section>
    <section
      class="logos flex flex-col items-center gap-6 px-8 py-24 flex-none self-stretch h-fit mobile:gap-4 mobile:px-5 mobile:py-14"
    >
      <p class="text-el-2 text-lg text-center text-(color:--neutral-ink)">
        Trusted by teams at
      </p>
    </section>
  </main>
</Base>
