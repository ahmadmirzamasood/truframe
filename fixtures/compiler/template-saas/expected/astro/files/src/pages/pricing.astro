---
import Base from "../layouts/Base.astro";
---

<Base title="Pricing">
  <main class="body flex flex-col w-full h-fit">
    <section
      class="pricing flex flex-col items-center gap-6 px-8 py-24 flex-none self-stretch h-fit mobile:gap-4 mobile:px-5 mobile:py-14"
    >
      <h1
        class="text text-[56px] font-bold text-center text-(color:--neutral-ink) mobile:text-4xl"
      >
        Pricing
      </h1>
      <h2
        class="text-el-2 text-4xl font-bold text-center text-(color:--neutral-ink) mobile:text-[28px]"
      >
        Starter
      </h2>
      <h2
        class="text-el-3 text-4xl font-bold text-center text-(color:--neutral-ink) mobile:text-[28px]"
      >
        Pro
      </h2>
      <h2
        class="text-el-4 text-4xl font-bold text-center text-(color:--neutral-ink) mobile:text-[28px]"
      >
        Business
      </h2>
    </section>
  </main>
</Base>
