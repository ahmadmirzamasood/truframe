{
  "schemaVersion": 1,
  "id": "0199a0b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b",
  "framework": "astro",
  "settings": {
    "lang": "pt-BR"
  },
  "breakpoints": {
    "desktop": {
      "width": 1440
    }
  },
  "pages": [
    {
      "id": "id1",
      "name": "Home",
      "path": "/",
      "seo": {
        "title": "Home",
        "description": "",
        "ogImage": null,
        "noindex": false
      },
      "root": "id2"
    },
    {
      "id": "about",
      "name": "About",
      "path": "/about",
      "seo": {
        "title": "About",
        "description": "",
        "ogImage": "photo",
        "noindex": false
      },
      "root": "aboutBody"
    }
  ],
  "nodes": {
    "id2": {
      "id": "id2",
      "type": "frame",
      "name": "Body",
      "tag": "main",
      "style": {
        "desktop": {
          "display": "stack",
          "direction": "column",
          "width": {
            "type": "fill"
          },
          "height": {
            "type": "fit"
          }
        }
      },
      "children": [
        "hero"
      ]
    },
    "aboutBody": {
      "id": "aboutBody",
      "type": "frame",
      "name": "Body",
      "tag": "main",
      "style": {
        "desktop": {}
      },
      "children": []
    },
    "hero": {
      "id": "hero",
      "type": "frame",
      "name": "Hero",
      "tag": "section",
      "style": {
        "desktop": {
          "display": "stack",
          "direction": "row",
          "gap": {
            "var": "space"
          },
          "padding": {
            "top": 8,
            "right": 8,
            "bottom": {
              "var": "space"
            },
            "left": 8
          },
          "fill": {
            "type": "solid",
            "color": {
              "var": "brand"
            }
          }
        },
        "mobile": {
          "direction": "column"
        }
      },
      "children": [
        "title",
        "pic",
        "cta",
        "card"
      ]
    },
    "title": {
      "id": "title",
      "type": "text",
      "name": "",
      "tag": "h1",
      "style": {
        "desktop": {
          "font": {
            "var": "body"
          },
          "textColor": "#111111"
        }
      },
      "content": [
        {
          "text": "Hello "
        },
        {
          "text": "world",
          "bold": true
        }
      ]
    },
    "pic": {
      "id": "pic",
      "type": "image",
      "name": "",
      "tag": "img",
      "assetId": "photo",
      "alt": "A photo",
      "decorative": false,
      "fit": "crop",
      "style": {
        "desktop": {}
      }
    },
    "cta": {
      "id": "cta",
      "type": "link",
      "name": "CTA",
      "tag": "a",
      "target": {
        "type": "page",
        "pageId": "about"
      },
      "newTab": false,
      "style": {
        "desktop": {}
      },
      "children": [
        "ctaLabel"
      ]
    },
    "ctaLabel": {
      "id": "ctaLabel",
      "type": "text",
      "name": "",
      "tag": "span",
      "style": {
        "desktop": {}
      },
      "content": [
        {
          "text": "About"
        }
      ]
    },
    "card": {
      "id": "card",
      "type": "instance",
      "name": "Card",
      "tag": "div",
      "componentId": "Card",
      "style": {
        "desktop": {}
      },
      "overrides": {
        "variant": {
          "size": "large"
        },
        "props": {
          "title": "Hi"
        },
        "nodes": {
          "cardTitle": {
            "style": {
              "mobile": {
                "fontSize": 12
              }
            }
          }
        }
      }
    },
    "cardRoot": {
      "id": "cardRoot",
      "type": "frame",
      "name": "Card",
      "tag": "div",
      "style": {
        "desktop": {}
      },
      "children": [
        "cardTitle"
      ]
    },
    "cardTitle": {
      "id": "cardTitle",
      "type": "text",
      "name": "Title",
      "tag": "h3",
      "style": {
        "desktop": {}
      },
      "content": [
        {
          "text": "Title"
        }
      ]
    }
  },
  "components": {
    "Card": {
      "id": "Card",
      "name": "Card",
      "root": "cardRoot",
      "props": [
        {
          "name": "title",
          "type": "text",
          "default": "Title",
          "target": {
            "nodeId": "cardTitle",
            "field": "content"
          }
        }
      ],
      "variantProps": [
        {
          "name": "size",
          "values": [
            "default",
            "large"
          ],
          "default": "default"
        }
      ],
      "variants": {
        "size=large": {
          "cardRoot": {
            "desktop": {
              "padding": {
                "top": 32,
                "right": 32,
                "bottom": 32,
                "left": 32
              }
            }
          }
        }
      }
    }
  },
  "variables": {
    "brand": {
      "id": "brand",
      "name": "Brand",
      "group": "Colors",
      "cssName": "--colors-brand",
      "type": "color",
      "value": {
        "desktop": "#ff0000",
        "mobile": "#00ff00"
      }
    },
    "space": {
      "id": "space",
      "name": "Md",
      "group": "Spacing",
      "cssName": "--spacing-md",
      "type": "spacing",
      "value": {
        "desktop": 24,
        "tablet": 16
      }
    },
    "body": {
      "id": "body",
      "name": "Body",
      "group": "Text",
      "cssName": "--text-body",
      "type": "font",
      "value": {
        "desktop": {
          "family": "Inter",
          "weight": 400,
          "size": 16,
          "lineHeight": 1.5,
          "letterSpacing": 0
        }
      }
    }
  },
  "assets": {
    "photo": {
      "id": "photo",
      "name": "photo.png",
      "mime": "image/png",
      "width": 800,
      "height": 600,
      "bytes": 1234,
      "key": "assets/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.png"
    }
  }
}
