---
import Base from "../layouts/Base.astro";
---

<Base title="Home">
  <main class="body flex flex-col w-full h-fit">
    <p class="braces">
      Use &#123;curly&#125; braces, &lt;angle&gt; brackets &amp; ampersands.
    </p>
    <p class="quotes">"Double", 'single' and `backticks` \ backslash.</p>
    <p class="unicode">Grüezi 👋 — naïve café, 日本語.</p>
    <p class="whitespace text-center">  leading and trailing  </p>
    <p class="multiline">Line one<br />Line two<br /><br />Line four</p>
    <p class="long">
      This sentence is long enough that the printer must move it onto its own line instead of keeping it next to the tag.
    </p>
  </main>
</Base>
