---
import Base from "../layouts/Base.astro";
import PricingCard from "../components/PricingCard.astro";
---

<Base title="Home">
  <main class="body flex flex-col w-full h-fit">
    <section
      class="pricing flex justify-center gap-6 mobile:flex-col mobile:items-center"
    >
      <PricingCard class="free flex flex-none w-70 mobile:flex-initial" />
      <PricingCard
        class="pro flex flex-1 mobile:flex-initial mobile:self-stretch"
        title="Pro"
        price="$24"
      />
      <PricingCard
        class="pricing-card-2 flex flex-none w-70 mobile:flex-initial"
        title="Team"
        price="$99"
      />
    </section>
  </main>
</Base>
