{
  "name": "@truframe/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app: marketing, auth, dashboard, editor, settings",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "opennextjs-cloudflare build --env=staging && opennextjs-cloudflare deploy --env=staging",
    "deploy:production": "opennextjs-cloudflare build --env=production && opennextjs-cloudflare deploy --env=production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@truframe/ui": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "wrangler": "4.166.0"
  }
}
