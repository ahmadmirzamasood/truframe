{
  "name": "@truframe/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app: marketing, auth, dashboard, editor, settings",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && next dev",
    "build": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && next build",
    "start": "next start",
    "typecheck": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "opennextjs-cloudflare build --env=staging && opennextjs-cloudflare deploy --env=staging",
    "deploy:production": "opennextjs-cloudflare build --env=production && opennextjs-cloudflare deploy --env=production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@truframe/auth": "workspace:*",
    "@truframe/billing": "workspace:*",
    "@truframe/db": "workspace:*",
    "@truframe/editor": "workspace:*",
    "@truframe/emails": "workspace:*",
    "@truframe/integrations": "workspace:*",
    "@truframe/model": "workspace:*",
    "@truframe/protocol": "workspace:*",
    "@truframe/sync": "workspace:*",
    "@truframe/ui": "workspace:*",
    "better-auth": "1.7.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "wrangler": "4.166.0"
  }
}
